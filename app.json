{
  "expo": {
    "name": "smart-Visualization",
    "slug": "smart-Visualization",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "assets/Icon/Layer.png",
    "scheme": "smartvisualization",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ea.amanullah.smartVisualization"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "assets/Icon/Layer.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.ea.amanullah.smartVisualization"
    },
    "web": {
      "output": "static",
      "favicon": "assets/Icon/Layer.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "assets/Icon/Layer.png"
        }
      ],
      "expo-mail-composer"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "7ee1d200-e1ca-4f45-8358-257295d0bdd1"
      }
    }
  }
}
